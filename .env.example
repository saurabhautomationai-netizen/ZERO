# ZERO — Environment Configuration Template

# Web Service Port & Host
ZERO_HOST=127.0.0.1
ZERO_PORT=8000

# Personal Finance Database (Read-Only PostgreSQL Role)
# Example: postgresql://zero_finance_reader:YourSecurePassword@localhost:5432/n8n_finance
FINANCE_DB_URL=

# AI Model Provider API Keys (Optional, for Agency Specialists)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Telegram Bot Interface (Optional, for Telegram Remote Control)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

# Local Sibling Paths (Defaults automatically detected if in same parent folder)
# AGENCY_AGENTS_PATH=../Agency-agents
# TRADING_BOT_PATH=../Trading bot
